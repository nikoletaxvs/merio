# Copy this file to .env and fill in real values:
#   cp .env.example .env

# Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/merio

# Signs session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-string

# Password for logging into the dashboard
OWNER_PASSWORD=change-me

# Bearer token required by /api/payments/generate and /api/payments/remind
CRON_SECRET=replace-with-a-random-string

# Gmail account used to send reminder emails.
# GMAIL_APP_PASSWORD is a Google "App password", not your normal password.
GMAIL_USER=you@example.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Receipt verifier (merio/verifier). Leave VERIFIER_URL unset to disable
# screenshot checking: payments then go to the owner for review.
# PythonAnywhere's free plan is HTTP-only, which is fine because this is
# fetched from the Vercel server, never from a browser.
# VERIFIER_URL=http://your-username.pythonanywhere.com
# VERIFIER_TOKEN=replace-with-the-verifiers-service-token

# Optional: demo deployment only. Enables password-free entry, fake seed data,
# nightly reset, and disables real email. NEVER set on the real deployment.
# DEMO_MODE=true

# Optional: real deployment only. Link to the demo, shown on the landing page.
# DEMO_URL=https://your-demo.vercel.app/demo

# Optional: public URL used in payment links. Falls back to the Vercel URL,
# then the request host.
APP_URL=http://localhost:3000
